{
  "name": "qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "슬라임 게임 자동 테스트 (Playwright) + 결과 리포트 + Jira 무료 플랜 연동",
  "scripts": {
    "test": "playwright test tests/slimegame.spec.js",
    "report": "python -I tools/make_report.py",
    "bug-demo": "python -I tools/bug_demo.py",
    "jira:tcs": "python -I tools/jira_sync.py tcs",
    "jira:bugs": "python -I tools/jira_sync.py bugs",
    "test:bloodfall": "playwright test tests/bloodfall.spec.js",
    "report:bloodfall": "python -I tools/make_report.py --game bloodfall",
    "jira:tcs:bloodfall": "python -I tools/jira_sync.py tcs --game bloodfall",
    "jira:bugs:bloodfall": "python -I tools/jira_sync.py bugs --game bloodfall",
    "tc:xlsx": "python -I tools/export_tc_xlsx.py --all",
    "tc:check": "python -I tools/check_tc.py --all"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
